[Unit]
Description=NlsxNetOS persistent Ubuntu router runtime
After=network-online.target frr.service
Wants=network-online.target
Requires=frr.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nlsxnetos router enable
ExecStop=/usr/bin/nlsxnetos router disable
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
