[Unit]
Description=NlsxNetOS NLS router daemon
After=network-online.target frr.service
Wants=network-online.target
Requires=frr.service
[Service]
Type=simple
ExecStart=/usr/bin/nlsxnetos nls run
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/nlsxnetos /var/log/nlsxnetos
[Install]
WantedBy=multi-user.target
