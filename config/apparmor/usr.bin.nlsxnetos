#include <tunables/global>

profile nlsxnetos flags=(attach_disconnected) {
  # Confines the NLS service launcher and all inherited helper processes.
  # The systemd unit separately restricts UID, capabilities, devices, and syscalls.
  #include <abstractions/base>
  #include <abstractions/nameservice>

  capability net_admin,

  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix,

  /usr/bin/nlsxnetos rix,
  /bin/sh rix,
  /usr/bin/python3* rix,
  /usr/sbin/ip rix,

  /usr/lib/python3*/** r,
  /usr/lib/python3*/**.so* mr,
  /usr/local/lib/python3*/** r,
  /usr/local/lib/python3*/**.so* mr,
  /usr/lib/**/lib*.so* mr,
  /lib/**/lib*.so* mr,
  /lib64/**/lib*.so* mr,

  /etc/nlsxnetos/ r,
  /etc/nlsxnetos/*.yaml r,
  /var/lib/nlsxnetos/identity/ r,
  /var/lib/nlsxnetos/identity/ed25519.key rw,
  /run/nlsxnetos/ r,
  /run/nlsxnetos/** rw,
  /dev/net/tun rw,
  /proc/sys/net/ r,
  /proc/sys/net/** r,

  deny /etc/shadow r,
  deny /etc/sudoers* r,
  deny /root/** rwklx,
  deny /home/** rwklx,
  deny /var/lib/**/ssh/** rwklx,
}
