abi <abi/3.0>,
#include <tunables/global>

/usr/bin/nlsxnetos flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/python>

  /usr/bin/nlsxnetos r,
  # The CLI wrapper executes system Python in the same confined profile.
  /usr/bin/python3 rix,
  /usr/bin/python3.[0-9]* rix,
  /usr/bin/python3.[0-9]*/** mr,
  /usr/lib/python3/dist-packages/** r,
  /usr/lib/python3.*/** r,
  /lib/** mr,
  /usr/lib/** mr,
  /etc/nlsxnetos/** r,
  /var/lib/nlsxnetos/** rw,
  /var/log/nlsxnetos/** rw,
  /run/nlsxnetos/** rw,
  # Python tempfile and libraries that use mkstemp need a writable private temp area.
  /tmp/ rw,
  /tmp/** rwk,
  /var/tmp/ rw,
  /var/tmp/** rwk,

  capability net_admin,
  capability net_raw,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network netlink raw,
  /dev/net/tun rw,
  /usr/sbin/ip ix,
  /usr/bin/ip ix,
  /usr/bin/ping ix,
  /usr/bin/tracepath ix,
  /usr/bin/tracepath6 ix,
  /usr/bin/systemctl ix,
  /usr/bin/ss ix,
  # FRR read-only validation uses vtysh -c 'show version'.
  /usr/bin/vtysh ix,
  /usr/lib/frr/vtysh ix,
  /usr/lib/frr/** r,
  /etc/frr/vtysh.conf r,
  /etc/frr/frr.conf r,
  /etc/frr/daemons r,
  /etc/frr/** r,
  /run/frr/** rw,
  unix (connect, send, receive) type=stream,
  deny /etc/shadow r,
  deny /root/** rwklx,
  deny /home/** rwklx,
}
