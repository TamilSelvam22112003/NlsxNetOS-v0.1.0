[Unit]
Description=NlsxNetOS persistent NLS Router-CA control channel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nlsxnetos
Group=nlsxnetos
AppArmorProfile=nlsxnetos
ExecStart=/usr/bin/nlsxnetos router-ca-client run --config /etc/nlsxnetos/router-ca-client.yaml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/nlsxnetos/identity /var/lib/nlsxnetos/security /var/lib/nlsxnetos/rollback
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
