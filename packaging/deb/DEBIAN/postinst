#!/bin/sh
set -e

case "$1" in
  configure|abort-upgrade|abort-deconfigure|abort-remove) ;;
  *) exit 0 ;;
esac

if [ "$1" = configure ]; then
  if ! getent group nlsxnetos >/dev/null 2>&1; then
    addgroup --system nlsxnetos >/dev/null
  fi
  if ! getent passwd nlsxnetos >/dev/null 2>&1; then
    adduser --system --ingroup nlsxnetos --no-create-home --home /nonexistent --shell /usr/sbin/nologin nlsxnetos >/dev/null
  fi

  install -d -o nlsxnetos -g nlsxnetos -m 0750 /var/lib/nlsxnetos
  install -d -o nlsxnetos -g nlsxnetos -m 0700 /var/lib/nlsxnetos/identity
  install -d -o nlsxnetos -g nlsxnetos -m 0750 /var/lib/nlsxnetos/router-ca
  install -d -o nlsxnetos -g nlsxnetos -m 0750 /var/lib/nlsxnetos/security
  install -d -o nlsxnetos -g nlsxnetos -m 0700 /var/lib/nlsxnetos/rollback
  install -d -o root -g nlsxnetos -m 0750 /etc/nlsxnetos
  install -d -o root -g nlsxnetos -m 0750 /etc/nlsxnetos/router-ca
  install -d -o root -g root -m 0755 /var/log/nlsxnetos

  if [ -f /var/lib/nlsxnetos/identity/ed25519.key ]; then
    chown nlsxnetos:nlsxnetos /var/lib/nlsxnetos/identity/ed25519.key
    chmod 0600 /var/lib/nlsxnetos/identity/ed25519.key
  fi

  for f in /etc/nlsxnetos/*.yaml; do
    [ -f "$f" ] || continue
    chown root:nlsxnetos "$f"
    chmod 0640 "$f"
  done

  if command -v systemd-tmpfiles >/dev/null 2>&1 && [ -f /usr/lib/tmpfiles.d/nlsxnetos.conf ]; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/nlsxnetos.conf >/dev/null 2>&1 || true
  fi

  systemctl daemon-reload >/dev/null 2>&1 || true
  # FRR is an external dependency. Probe it outside the NlsxNetOS AppArmor profile.
  if ! command -v vtysh >/dev/null 2>&1; then
    echo "ERROR: vtysh is required; install FRR before configuring NlsxNetOS." >&2
    exit 1
  fi
  vtysh -c "show version" >/dev/null
  systemctl enable nlsxnetos-router.service >/dev/null 2>&1 || true
  systemctl enable nls-router.service >/dev/null 2>&1 || true
  # The mNLS client service is intentionally not enabled automatically. It requires
  # a pinned Router-CA identity key and administrator-provisioned credentials.

  if command -v apparmor_parser >/dev/null 2>&1; then
    apparmor_parser -r /etc/apparmor.d/usr.bin.nlsxnetos
  fi
fi
exit 0
