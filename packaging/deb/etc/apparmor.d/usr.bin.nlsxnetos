#include <tunables/global>

profile nlsxnetos /usr/bin/nlsxnetos flags=(attach_disconnected) {
  # The installed launcher is a fixed root-owned file. Python and ip inherit
  # this profile rather than becoming separate unconfined domains.
  #include <abstractions/base>
  #include <abstractions/nameservice>

  capability net_admin,

  network inet dgram,
  network inet6 dgram,
  network netlink raw,
  network unix,

  /usr/bin/nlsxnetos rix,
  /bin/sh rix,
  /usr/bin/python3 rix,
  /usr/sbin/ip rix,

  /usr/lib/python3*/** r,
  /usr/local/lib/python3*/** r,
  /usr/lib/**/lib*.so* mr,
  /lib/**/lib*.so* mr,
  /lib64/**/lib*.so* mr,

  /etc/nlsxnetos/*.yaml r,
  /var/lib/nlsxnetos/identity/ r,
  /var/lib/nlsxnetos/identity/ed25519.key rw,
  /run/nlsxnetos/ r,
  /run/nlsxnetos/** rw,
  /dev/net/tun rw,

  /proc/sys/net/ r,
  /proc/sys/net/** r,

  deny /etc/shadow r,
  deny /etc/sudoers* r,
  deny /root/** rwklx,
  deny /home/** rwklx,
  deny /var/lib/**/ssh/** rwklx,
}
